{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/public-engine/schema/pipeline.schema.json",
  "title": "Public engine pipeline contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template", "kind", "project_types", "validation", "artifacts", "delivery", "environments"],
  "properties": {
    "schema_version": {"const": 1},
    "template": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"},
    "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation": {"type": "object"},
    "artifacts": {"type": "array"},
    "delivery": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"const": false}}},
    "environments": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
